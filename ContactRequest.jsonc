{
  "name": "ContactRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "company": {
      "type": "string",
      "maxLength": 160
    },
    "product": {
      "type": "string",
      "enum": [
        "ai_receptionist",
        "knowledge_ai",
        "general"
      ]
    },
    "topic": {
      "type": "string",
      "maxLength": 200
    },
    "message": {
      "type": "string",
      "maxLength": 4000
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "done",
        "archived"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "product"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}