{
  "name": "DemoRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "company": {
      "type": "string",
      "maxLength": 160
    },
    "website": {
      "type": "string",
      "maxLength": 300
    },
    "product": {
      "type": "string",
      "enum": [
        "ai_receptionist",
        "knowledge_ai",
        "both"
      ]
    },
    "use_case": {
      "type": "string",
      "maxLength": 2000
    },
    "preferred_contact_time": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "converted",
        "archived"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "product"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}